    {
      "view": "handoff",
      "title": "随时叫它回来",
      "body": "推一个信号分支。云端做完当前单元就停，你的电脑接着做。",
      "focus": {
        "nodes": [
          "signal",
          "stop",
          "resume"
        ]
      },
      "trace": {
        "edges": [
          "see-signal",
          "obey",
          "back"
